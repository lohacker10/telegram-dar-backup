# Telegram: create an API ID/hash at https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Private channel ID; telegram_login.py can list visible channel IDs
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_SESSION_FILE=/var/lib/telegram-dar-backup/telegram.session

# Directory or mount point to back up
SOURCE=/mnt/data
SOURCE_LABEL=NAS-DATA
# true protects against the case where SOURCE exists but the disk is not mounted
REQUIRE_SOURCE_MOUNT=true

# Runtime state and temporary files. Only a few GB are normally required because
# slices are uploaded and removed progressively.
WORK_DIR=/var/lib/telegram-dar-backup
SLICE_SIZE=1900M
COMPRESSION=zstd:6
FULL_EVERY_MONTHS=6
KEEP_ONLY_LATEST_DIFF=true

# RECOMMENDED: root-only file containing the DAR password on one line
DAR_PASSPHRASE_FILE=/etc/telegram-dar-backup/dar.pass

# Alternative: put the password directly here. If used, keep config.env mode 0600
# and NEVER commit the real config.env to Git.
# DAR_PASSPHRASE=replace-with-a-long-random-password
