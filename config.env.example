# Telegram DAR Backup configuration
#
# Copy this file to:
#   /etc/telegram-dar-backup/config.env
#
# Then edit the values marked REQUIRED.

# -----------------------------------------------------------------------------
# TELEGRAM
# -----------------------------------------------------------------------------

# REQUIRED.
# Telegram API ID created at https://my.telegram.org under "API development tools".
# This is NOT a bot token.
TELEGRAM_API_ID=12345678

# REQUIRED.
# Telegram API Hash created together with TELEGRAM_API_ID.
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# REQUIRED AFTER THE FIRST LOGIN.
# Numeric ID of the private Telegram channel that will store the backups.
#
# You do not need to know this value before the first Telethon login.
# First configure TELEGRAM_API_ID and TELEGRAM_API_HASH, then run:
#
#   sudo /opt/telegram-dar-backup/venv/bin/python \
#     /opt/telegram-dar-backup/telegram_login.py \
#     --config /etc/telegram-dar-backup/config.env
#
# The script lists all visible channels/groups with their IDs.
# Copy the desired value here, including the leading -100.
TELEGRAM_CHANNEL_ID=-1001234567890

# Usually leave this unchanged.
# Telethon stores the authenticated session here so scheduled backups do not
# require a phone/code login every month. Treat this file like a password.
TELEGRAM_SESSION_FILE=/var/lib/telegram-dar-backup/telegram.session

# -----------------------------------------------------------------------------
# SOURCE DATA
# -----------------------------------------------------------------------------

# REQUIRED.
# Directory or mounted filesystem to back up.
# Examples:
#   SOURCE=/mnt/data
#   SOURCE=/srv/storage
#   SOURCE=/mnt/storage/documents
SOURCE=/mnt/data

# Optional descriptive label stored in backup metadata/manifests.
# It does not change what is backed up.
SOURCE_LABEL=NAS-DATA

# Safety check for SOURCE.
#
# true  = SOURCE must itself be a mounted filesystem/mount point.
#         Recommended for an external HDD, RAID volume, etc. This prevents
#         accidentally backing up an empty mount directory if the disk is not
#         mounted.
#
# false = SOURCE may be a normal directory or a subdirectory inside a mounted
#         filesystem.
#
# Examples:
#   SOURCE=/mnt/data            -> normally true
#   SOURCE=/mnt/data/documents  -> normally false
REQUIRE_SOURCE_MOUNT=true

# -----------------------------------------------------------------------------
# LOCAL WORKING STATE
# -----------------------------------------------------------------------------

# Usually leave this unchanged.
# Stores runtime state, the local FULL catalogue cache, temporary files and the
# Telethon session. It does NOT store the complete backup: slices are uploaded
# and removed progressively.
WORK_DIR=/var/lib/telegram-dar-backup

# -----------------------------------------------------------------------------
# BACKUP FORMAT
# -----------------------------------------------------------------------------

# Maximum DAR slice size.
# 1900M intentionally stays below Telegram's standard 2 GB per-file limit.
# Smaller values create more Telegram messages but need less temporary space.
SLICE_SIZE=1900M

# DAR compression algorithm and level.
# zstd:6 is a reasonable default for mixed data. zstd:3 uses less CPU.
# Already-compressed media such as JPEG, MP4 and ZIP usually gains little from
# stronger compression.
COMPRESSION=zstd:6

# Create a new FULL backup when the latest FULL is at least this many months old.
# With 6:
#   month 1 -> FULL
#   months 2-6 -> DIFF against that FULL
#   month 7 -> new FULL
FULL_EVERY_MONTHS=6

# true  = after a new DIFF completes successfully, delete the previous DIFF
#         belonging to the same FULL generation. This keeps FULL + latest DIFF.
#
# false = keep older monthly DIFF backups as additional restore points. Telegram
#         storage usage will grow over time.
KEEP_ONLY_LATEST_DIFF=true

# -----------------------------------------------------------------------------
# DAR ENCRYPTION PASSWORD
# -----------------------------------------------------------------------------

# RECOMMENDED.
# Path to a root-only file containing the DAR encryption password on ONE line.
# install.sh creates this file automatically with a random password if it does
# not already exist.
#
# IMPORTANT: keep a secure copy of this password somewhere outside the NAS.
# Without it, encrypted backups cannot be restored.
DAR_PASSPHRASE_FILE=/etc/telegram-dar-backup/dar.pass

# Alternative to DAR_PASSPHRASE_FILE:
# store the password directly in config.env.
# If used, comment/remove DAR_PASSPHRASE_FILE and protect config.env with 0600.
# The separate password file above is recommended.
# DAR_PASSPHRASE=replace-with-a-long-random-password
